Options -Indexes

RewriteEngine On

# HTTP'den HTTPS'e yönlendirme - 308 kullanarak POST metodunu koru
# (301/302 yönlendirmeleri POST'u GET'e çevirir, 308 korur)
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=308]

# www olmayan domain'e yönlendir (non-www tercih ediliyorsa)
# www.gezgintilki.com -> gezgintilki.com
# Aşağıdaki satırları sunucu yapınıza göre etkinleştirin:
# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
# RewriteRule ^ https://%1%{REQUEST_URI} [L,R=308]
